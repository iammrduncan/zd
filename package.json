{
  "name": "zd",
  "private": true,
  "version": "0.2.10",
  "type": "module",
  "description": "ZenSuite — a fast, local agent workbench for projects, threads, terminals, files, and Git.",
  "license": "MIT",
  "repository": "https://github.com/iammrduncan/zd",
  "workspaces": [
    "packages/website"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "preview": "vite preview",
    "dev:website": "npm run dev --workspace @zd/website",
    "website:dev": "npm run dev --workspace @zd/website",
    "website:build": "npm run build --workspace @zd/website",
    "website:preview": "npm run preview --workspace @zd/website",
    "release:check": "node packages/scripts/release/check-tag.mjs",
    "app": "ZD_CWD=\"$INIT_CWD\" tauri dev --config packages/tauri/tauri.conf.json -- --",
    "app:open": "ZD_CWD=\"$INIT_CWD\" tauri dev --config packages/tauri/tauri.conf.json -- --",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "bash packaging/macos/generate-icons.sh",
    "install:macos": "bash packaging/macos/install.sh",
    "package:macos": "bash packaging/macos/package.sh",
    "promo:capture": "node packages/scripts/release/capture-workbench.mjs",
    "promo:render": "swift packaging/macos/render-social-card.swift docs/user-facing-docs/assets/zd-reader.jpeg docs/user-facing-docs/assets/zd-reader-dark.png docs/user-facing-docs/assets/zd-reader-dracula.png packaging/icon.png packages/app/assets/fonts/iAWriterQuattroV.ttf packages/app/assets/fonts/iAWriterQuattroS-Bold.ttf packages/app/assets/fonts/iAWriterMonoS-Regular.ttf docs/user-facing-docs/assets/zd-social-card.png",
    "tokens:unused": "node packages/scripts/audit/unused-tokens.mjs",
    "zdarchive": "node packages/scripts/objectives/archive.mjs",
    "zdloop": "node packages/scripts/session-loop/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --config playwright.release.config.ts",
    "version": "node packages/scripts/release/sync-version.mjs",
    "version:bump": "npm version --no-git-tag-version",
    "version:check": "node packages/scripts/release/sync-version.mjs --check",
    "check": "npm run typecheck && npm run lint && npm test && npm run version:check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2",
    "@vscode/codicons": "0.0.46-24",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/xterm": "5.5.0",
    "beautiful-mermaid": "1.1.3",
    "markdown-it": "^14.3.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
