{
  "name": "zd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zen Suite \u2014 focused tools for AI-assisted development. Tool #1 is zd md.",
  "license": "MIT",
  "repository": "https://github.com/iammrduncan/zd",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "release:check": "node packages/scripts/check-release-tag.mjs",
    "app": "tauri dev --config packages/tauri/tauri.conf.json",
    "app:open": "ZD_CWD=\"$INIT_CWD\" tauri dev --config packages/tauri/tauri.conf.json -- --",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "bash packaging/macos/generate-icons.sh",
    "install:macos": "bash packaging/macos/install.sh",
    "package:macos": "bash packaging/macos/package.sh",
    "promo:render": "swift packaging/macos/render-social-card.swift docs/assets/zd-reader.jpeg packaging/icon.png packages/app/assets/fonts/iAWriterQuattroV.ttf packages/app/assets/fonts/iAWriterQuattroS-Bold.ttf packages/app/assets/fonts/iAWriterMonoS-Regular.ttf docs/assets/zd-social-card.png",
    "tokens:unused": "node packages/scripts/list-unused-tokens.mjs",
    "zdarchive": "node packages/scripts/archive-tasks.mjs",
    "zdloop": "node packages/scripts/session-loop.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "version": "node packages/scripts/sync-version.mjs",
    "version:bump": "npm version --no-git-tag-version",
    "version:check": "node packages/scripts/sync-version.mjs --check",
    "check": "npm run typecheck && npm run lint && npm test && npm run version:check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2",
    "markdown-it": "^14.3.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
