# Pin what gets added from here on — AGENTS.md: "Pin versions, audit what
# matters." Audit finding L4: the policy said pin and every range in
# package.json was a caret.
#
# This only governs *new* adds. The existing ranges are left alone deliberately:
# rewriting them all is a dependency-bump session with its own verification, not
# a line in a cleanup one, and the lockfile plus `npm ci` in CI is what actually
# makes an install reproducible today. So the rule holds from here forward and
# each existing range is pinned when something touches it.
save-exact=true
