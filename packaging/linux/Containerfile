# Build and test toolchain for zd on machines without a native one.
#
#   podman build -t localhost/zd-build:bookworm -f packaging/linux/Containerfile packaging/linux
#
# dev-container.sh builds this on demand and mounts the checkout, the Cargo
# caches, and the Playwright browser cache, so artifacts stay owned by the
# invoking user and dependencies are not fetched twice.

FROM docker.io/library/node:24-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    file \
    curl \
    wget \
    git \
    ca-certificates \
    xdg-utils \
    xvfb \
    libssl-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libsoup-3.0-dev \
    libxdo-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain 1.97.1 \
    && rustup component add clippy rustfmt \
    && chmod 0777 /usr/local/cargo

# Chromium's system dependencies so the mounted browser cache can run here.
RUN npm install -g playwright@1 \
    && playwright install-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# Writable home for uid-mapped invocations (--userns=keep-id).
RUN mkdir -p /home/dev/.cache/ms-playwright && chmod -R 0777 /home/dev
ENV HOME=/home/dev

WORKDIR /src
